{
  "name": "@foss-earth/research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Earth research sources, hypotheses, experiment records and retained evidence. This repository is not an application runtime dependency.",
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/research.git"
  },
  "files": [
    "docs",
    "benchmarks",
    "validation",
    "scripts",
    "fixtures",
    "README.md",
    "navigation.md",
    "migration.md",
    "LICENSE",
    "NOTICE",
    "source-routing.json",
    "link-routing.json",
    "component-transfers.json",
    "SOURCE_PROVENANCE.json",
    "SOURCE_RECEIPT.json",
    "tools-manifest.json",
    ".attribution.json",
    ".attribution-release.json",
    ".github/workflows/attribution-check.yml",
    "tsconfig.fixtures.json",
    "SOURCE_LINEAGE.json"
  ],
  "scripts": {
    "check:links": "node scripts/check-links.mjs",
    "test:source": "node --test --test-concurrency=1 fixtures/*.test.mjs",
    "check:source": "npm run check:links && npm run check:tools && npm run test:source",
    "check:implementation": "npm run check:source && npm run check:public-ports && npm run test:consumer",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file build/repository-split/intended-publication-refs.json",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root build/common-conformance",
    "ci": "npm run check:conformance && npm run check:implementation",
    "check:tools": "node scripts/check-tool-sources.mjs",
    "check:public-ports": "tsc --project tsconfig.fixtures.json",
    "test:consumer": "node scripts/check-public-consumer.mjs"
  },
  "devDependencies": {
    "@foss-earth/ci": "0.1.0",
    "@foss-earth/images": "0.1.0",
    "@foss-earth/engine": "0.1.0",
    "@foss-earth/renderer": "0.1.0",
    "@foss-earth/ui": "0.1.0",
    "@foss-earth/cubemap": "0.1.0",
    "@foss-earth/equirectangular": "0.1.0",
    "@babylonjs/core": "8.56.2",
    "typescript": "5.9.3",
    "@types/node": "24.12.4"
  },
  "exports": {
    "./headless-chrome": {
      "types": "./scripts/lib/headlessChrome.d.mts",
      "import": "./scripts/lib/headlessChrome.mjs"
    },
    "./output-directory": {
      "types": "./scripts/lib/outputDirectory.d.mts",
      "import": "./scripts/lib/outputDirectory.mjs"
    }
  }
}
